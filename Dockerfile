# Dockerfile — инструкция сборки Docker-образа приложения.
#
# Зачем Docker:
#   • Воспроизводимость: образ одинаково работает на любом сервере,
#     независимо от ОС и установленных пакетов.
#   • Изоляция: зависимости приложения не конфликтуют с системными.
#   • Безопасность: секреты (.env) не вшиваются в образ — передаются
#     через переменные окружения при запуске контейнера.
#
# Сборка образа:     docker compose build
# Разовый запуск:    docker compose run --rm assistant python ingest.py
# Запуск сервиса:    docker compose up -d

# python:3.11-slim — официальный минималистичный образ Python 3.11 на базе
# Debian Bookworm без лишних утилит. Размер ~130 МБ против ~1 ГБ у полного
# образа. Достаточен для нашего приложения — все необходимые зависимости
# устанавливаются через pip.
FROM python:3.11-slim

# WORKDIR создаёт папку /app и устанавливает её как текущую для всех
# последующих команд (RUN, COPY, CMD). 
WORKDIR /app

# Копируем requirements.txt ОТДЕЛЬНО от остального кода — это важная
# оптимизация Docker-кеша: слои пересобираются только если их входные
# данные изменились. 
COPY requirements.txt .

# --no-cache-dir экономит место: pip не сохраняет скачанные wheel-файлы
# в кеш (он не нужен внутри образа — зависимости уже установлены).
RUN pip install --no-cache-dir -r requirements.txt

# Копируем только .py файлы — всё остальное исключено через .dockerignore.
# Важно: .env НЕ копируется в образ (он в .dockerignore).
# Секреты передаются через environment в docker-compose.yml.
# Это безопасно: даже если образ утечёт — ключей в нём нет.
COPY *.py .

# Папка data/ копируется в образ — лекции и глоссарий становятся частью
# образа. При обновлении документов нужно пересобрать образ (docker compose build).
COPY data ./data

# EXPOSE документирует, что приложение слушает порт 8501 внутри контейнера.
# Это метаданные — реальный проброс порта настраивается в docker-compose.yml
# через директиву ports: "8501:8501".
EXPOSE 8501

# CMD задаёт команду по умолчанию при запуске контейнера.
# --server.port=8501  — явно указываем порт (совпадает с EXPOSE)
# --server.address=0.0.0.0 — слушаем на всех интерфейсах, не только localhost.
#   Без этого флага Streamlit слушает только 127.0.0.1 и контейнер
#   будет недоступен снаружи, даже с пробросом порта.
CMD ["streamlit", "run", "app_streamlit.py", "--server.port=8501", "--server.address=0.0.0.0"]
