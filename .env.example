# GigaChat API — получить на https://developers.sber.ru/
GIGACHAT_CREDENTIALS=ваш_base64_ключ
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Пароль для входа в веб-интерфейс (логин: TM)
# Используйте надёжный пароль — не менее 12 символов
TM_PASSWORD=ваш_надёжный_пароль

# Опционально: токен HuggingFace Hub (убирает предупреждения при загрузке модели)
# HF_TOKEN=hf_...
